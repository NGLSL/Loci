#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/sbin LC_ALL=C
fail(){ echo "LOCI_BTRFS_FAIL init_or_workload_exit run_id=${LOCI_TOKEN:-unknown}"; sync; poweroff -f; }
trap fail EXIT
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
for module in virtio_blk crc32c_generic ext4 btrfs; do modprobe "$module"; done
mount -t ext4 -o ro,noload /dev/vda /artifacts
mount -t btrfs /dev/vdb /mnt/data
LOCI_SHA=;LOCI_TOKEN=
for arg in $(cat /proc/cmdline); do case "$arg" in loci_sha=*) LOCI_SHA=${arg#loci_sha=};; loci_run_id=*) LOCI_TOKEN=${arg#loci_run_id=};; esac; done
[ "$LOCI_SHA" = '@SOURCE_SHA@' ]
[ "$LOCI_TOKEN" = '@RUN_ID@' ]
[ "$(sha256sum /artifacts/content.json | cut -d' ' -f1)" = '@CONTENT_SHA@' ]
# Fixed builder JSON path alphabet is deliberately restricted; no raw path is interpolated.
awk -F '"' '$2=="guest_path"{p=$4} $2=="sha256"{print $4 "  /artifacts" p}' /artifacts/content.json | sha256sum -c -
@BIND_ARTIFACTS@
echo "LOCI_BTRFS_SOURCE sha=$LOCI_SHA content_sha256=@CONTENT_SHA@ run_id=$LOCI_TOKEN"
uname -a
cat /proc/cpuinfo
cat /proc/meminfo
cat /proc/mounts
for n in max_user_watches max_user_instances max_queued_events; do printf 'INOTIFY_LIMIT %s=' "$n"; cat "/proc/sys/fs/inotify/$n"; done
mkdir -p "/mnt/data/$LOCI_TOKEN/probe" "/mnt/data/$LOCI_TOKEN/results"
chown -R 1000:1000 "/mnt/data/$LOCI_TOKEN"
export LOCI_SHA LOCI_TOKEN LOCI_FINAL_CLI='@CLI@' LOCI_FINAL_DRIVER='@DRIVER@'
cd "/mnt/data/$LOCI_TOKEN/probe"
su -s /bin/sh probe -c '/guest/native-probe /guest/readonly-proof'
/guest/orchestrate.sh
sync
echo "LOCI_BTRFS_WORKLOAD_PASS run_id=$LOCI_TOKEN"
echo "LOCI_BTRFS_COMPLETE run_id=$LOCI_TOKEN"
trap - EXIT
poweroff -f
