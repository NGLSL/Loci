#!/bin/sh
set -eu
export LC_ALL=C PATH=/usr/bin:/bin:/sbin
BASE="/mnt/data/$LOCI_TOKEN"
RESULTS="$BASE/results"
EXTRA=@RESULT_BUDGET@
usage(){
 /guest/btrfs filesystem usage -b /mnt/data > "$RESULTS/usage-$1.txt"
 cat "$RESULTS/usage-$1.txt"
 awk -v reserve="$2" -v physical_out="$RESULTS/physical-$1.txt" -f /guest/usage_guard.awk "$RESULTS/usage-$1.txt"
}
usage before-pilot "$EXTRA"
su -s /bin/sh probe -c 'exec /guest/fixture "/mnt/data/$LOCI_TOKEN/million" 2000 @RESULT_BUDGET@ "$LOCI_TOKEN"'
sync
usage after-pilot "$EXTRA"
LOCI_BEFORE=$(cat "$RESULTS/physical-before-pilot.txt")
LOCI_AFTER=$(cat "$RESULTS/physical-after-pilot.txt")
# Conservative projected physical growth:1.5x actual100k pilot slope for remaining900k.
LOCI_PROJECTED=$(awk -v a="$LOCI_BEFORE" -v b="$LOCI_AFTER" -v extra="$EXTRA" 'BEGIN{if(b<=a)exit 1;printf "%.0f\n",(b-a)*9*1.5+extra}')
usage projected-million "$LOCI_PROJECTED"
echo "LOCI_BTRFS_METADATA_PILOT actual_entries=100000 physical_before=$LOCI_BEFORE physical_after=$LOCI_AFTER projected_remaining_plus_outputs=$LOCI_PROJECTED fixed_inode_capacity=unavailable"
su -s /bin/sh probe -c '/guest/workload.sh pilot'
su -s /bin/sh probe -c 'exec /guest/fixture "/mnt/data/$LOCI_TOKEN/million" 20000 @RESULT_BUDGET@ "$LOCI_TOKEN"'
sync
usage million-created "$EXTRA"
# Namespace/root privileges below only set up the owned mount/subvolume fixture.
su -s /bin/sh probe -c '/guest/btrfs-matrix prepare'
MATRIX_BASE=$(cat "/mnt/data/$LOCI_TOKEN/matrix-path")
MATRIX_SUB=$(/guest/btrfs subvolume show "$MATRIX_BASE/tree/sub-b" | awk '/Subvolume ID:/{print $3}')
MATRIX_A=$(/guest/btrfs subvolume show "$MATRIX_BASE/tree/sub-a" | awk '/Subvolume ID:/{print $3}')
test -n "$MATRIX_SUB";test -n "$MATRIX_A"
mount -t btrfs -o "subvolid=$MATRIX_SUB" /dev/vdb "$MATRIX_BASE/tree/mounted-sub"
mount --bind "$MATRIX_BASE/outside" "$MATRIX_BASE/tree/bind-boundary"
MATRIX_RAW=$(printf 'bind-\377-space x')
mount --bind "$MATRIX_BASE/outside" "$MATRIX_BASE/tree/$MATRIX_RAW"
mkdir -p /mnt/selected-sub
mount -t btrfs -o "subvolid=$MATRIX_A" /dev/vdb /mnt/selected-sub
cat /proc/self/mountinfo > "$RESULTS/native-mountinfo.txt"
su -s /bin/sh probe -c '/guest/workload.sh matrix'
LOCI_PILOT_DELTA=$(awk -v a="$LOCI_BEFORE" -v b="$LOCI_AFTER" 'BEGIN{if(b<=a)exit 1;printf "%.0f\n",b-a}')
export LOCI_PILOT_DELTA LOCI_TEST_SOURCE_SHA="$LOCI_SHA"
mkdir -m755 "$BASE/capacity"
root_native_job(){
 LOCI_JOB_ID=$1;LOCI_JOB_INDEX=$2
 LOCI_JOB_WORK="$BASE/native-$LOCI_JOB_ID"
 mkdir -m700 "$LOCI_JOB_WORK"
 chown 1000:1000 "$LOCI_JOB_WORK"
 LOCI_RAW="$BASE/capacity/$LOCI_JOB_ID.usage"
 LOCI_RECEIPT="$BASE/capacity/$LOCI_JOB_ID.receipt"
 /guest/btrfs filesystem usage -b "$LOCI_JOB_WORK" > "$LOCI_RAW"
 exec 9<"$LOCI_JOB_WORK"
 LOCI_MOUNT_ID=$(awk '/^mnt_id:/{print $2}' /proc/self/fdinfo/9)
 exec 9<&-
 [ -n "$LOCI_MOUNT_ID" ]
 {
  printf 'schema=loci.btrfs-capacity.v1\nsource_sha=%s\nrun_id=%s\ncreated_unix_seconds=%s\n' "$LOCI_SHA" "$LOCI_TOKEN" "$(date +%s)"
  printf 'workdir=%s\nworkdir_device=%s\nworkdir_inode=%s\nworkdir_mount_id=%s\n' "$(readlink -f "$LOCI_JOB_WORK")" "$(stat -c %d "$LOCI_JOB_WORK")" "$(stat -c %i "$LOCI_JOB_WORK")" "$LOCI_MOUNT_ID"
  printf 'pilot_entries=100000\npilot_delta_physical=%s\nusage_sha256=%s\n\n' "$LOCI_PILOT_DELTA" "$(sha256sum "$LOCI_RAW" | cut -d' ' -f1)"
  cat "$LOCI_RAW"
 } > "$LOCI_RECEIPT"
 chmod 0644 "$LOCI_RECEIPT"
 export LOCI_JOB_INDEX LOCI_BTRFS_CAPACITY_RECEIPT="$LOCI_RECEIPT"
 su -s /bin/sh probe -c '/guest/workload.sh native-job "$LOCI_JOB_INDEX"'
}
@ROOT_NATIVE_JOBS@
su -s /bin/sh probe -c '/guest/workload.sh million'
usage completed 0
printf 'LOCI_BTRFS_RETAINED_RESULTS image_path=declared_owned_data_image guest_path=%s\n' "$RESULTS"
