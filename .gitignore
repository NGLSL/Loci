# Explicit publication scope; local data, reports, transfers and backups stay private.
/*
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.gitattributes
!/src/
/src/*
!/src/lib.rs
!/src/index.rs
!/src/live.rs
!/src/main.rs
!/src/signatures.rs
!/src/watch.rs
!/src/watch_tests.rs
!/src/linux_inotify.rs
!/tests/
/tests/*
!/tests/filesystem.rs
!/tests/linux_acceptance.rs
!/tests/linux_watch.rs
!/tests/linux_live.rs
!/tests/live.rs
!/tests/common/
/tests/common/*
!/tests/common/mod.rs
!/scripts/
/scripts/*
!/scripts/validate-linux.sh
!/scripts/measure-live-linux.py
!/scripts/measure-live-windows.py
!/.gitignore
!/README.md
!/THIRD_PARTY.md
!/docs/
/docs/*
!/docs/VALIDATION.md
!/docs/BENCHMARKS.md
!/tests/linux_stage3_regressions.rs
